# MySQL: puede apuntar a Docker o a una instalación local.
DATABASE_URL="mysql://reportevias:reportevias@localhost:3306/reporte_vias"
# Base separada para las pruebas automáticas (npm test la borra y la vuelve a llenar).
DATABASE_URL_TEST="mysql://reportevias:reportevias@localhost:3306/reporte_vias_test"
PORT=4000
# Clave para firmar los JWT: mínimo 32 caracteres. Cámbiala en cualquier despliegue.
JWT_SECRET="cambia-esta-clave-por-una-segura-de-32-caracteres"
JWT_EXPIRA_EN="7d"
# Orígenes permitidos (separados por coma). Agrega http://<IP-de-tu-PC>:3000 para probar desde el celular.
CORS_ORIGIN="http://localhost:3000"
# Modo demostración: permite avanzar estados simulados y restablecer los datos de prueba.
MODO_DEMO=true
NOMINATIM_USER_AGENT="ReporteViasAcademico/1.0 (contacto@ejemplo.edu.co)"
# Pon false para no consultar Nominatim (se usan las coordenadas como dirección).
GEOCODIFICACION_EXTERNA=true
URL_PUBLICA_UPLOADS="http://localhost:4000/uploads"
DIRECTORIO_UPLOADS="uploads"
LIMITE_LOGIN_POR_15_MIN=10
LIMITE_REPORTES_POR_HORA=20

